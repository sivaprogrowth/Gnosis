filters:
  type == "company"
formulas:
  cites: 'if(sources, sources.length, 0)'
properties:
  formula.cites:
    displayName: "Cites"
views:
  - type: table
    name: "Companies grouped by tag"
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - formula.cites
      - website
    sort:
      - property: formula.cites
        direction: DESC
