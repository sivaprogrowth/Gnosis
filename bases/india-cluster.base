filters:
  and:
    - type != null
    - or:
        - file.hasTag("india")
        - file.hasTag("telangana")
        - file.hasTag("shared-connection")
        - 'note["based-in"].contains("India")'
        - 'headquartered.contains("India")'
properties:
  note.based-in:
    displayName: "Based in"
views:
  - type: table
    name: "India / Telangana cluster"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - based-in
      - headquartered
      - tags
    sort:
      - property: file.name
        direction: ASC
