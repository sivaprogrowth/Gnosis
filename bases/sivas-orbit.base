filters:
  or:
    - file.hasTag("siva")
    - file.hasTag("progrowth")
    - file.hasTag("founder")
formulas:
  cites: 'if(sources, sources.length, 0)'
properties:
  formula.cites:
    displayName: "Cites"
views:
  - type: table
    name: "Siva's orbit"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - tags
      - formula.cites
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
