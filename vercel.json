{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/ask.ts": {
      "maxDuration": 60
    },
    "api/search.ts": {
      "maxDuration": 60
    },
    "api/ingest/from-life.ts": {
      "maxDuration": 300
    }
  }
}
